{
  "name": "@ani-9/core",
  "version": "0.1.0",
  "description": "Open source ANI-9 flashcard content and research primitives",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./concepts": { "types": "./dist/concepts/index.d.ts", "default": "./dist/concepts/index.js" },
    "./content": { "types": "./dist/content/index.d.ts", "default": "./dist/content/index.js" },
    "./embeddings": { "types": "./dist/embeddings/index.d.ts", "default": "./dist/embeddings/index.js" },
    "./eval": { "types": "./dist/eval/index.d.ts", "default": "./dist/eval/index.js" },
    "./fsrs": { "types": "./dist/fsrs/index.d.ts", "default": "./dist/fsrs/index.js" },
    "./ingest": { "types": "./dist/ingest/index.d.ts", "default": "./dist/ingest/index.js" },
    "./model": { "types": "./dist/model/index.d.ts", "default": "./dist/model/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "check": "pnpm test && pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@google/genai": "2.24.0",
    "@huggingface/transformers": "4.3.0",
    "@mongodb-js/zstd": "7.0.0",
    "@open-spaced-repetition/binding": "0.5.0",
    "better-sqlite3": "13.0.3",
    "csv-parse": "7.0.3",
    "fflate": "0.8.3",
    "hyparquet": "1.31.1",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "publishConfig": { "access": "public" }
}
